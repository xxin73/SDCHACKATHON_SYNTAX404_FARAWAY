{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "node artifacts/faraway/node_modules/vite/bin/vite.js build --config artifacts/faraway/vite.config.ts",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm --filter @workspace/faraway typecheck",
    "dev": "node artifacts/faraway/node_modules/vite/bin/vite.js --config artifacts/faraway/vite.config.ts",
    "check:logic": "TSX_TSCONFIG_PATH=artifacts/faraway/tsconfig.json node --import ./scripts/node_modules/tsx/dist/loader.mjs scripts/check-logic.ts",
    "check:auth": "TSX_TSCONFIG_PATH=artifacts/faraway/tsconfig.json node --import ./scripts/node_modules/tsx/dist/loader.mjs --test scripts/tests/*.test.ts",
    "check:browser": "node scripts/check-auth-browser.mjs"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
