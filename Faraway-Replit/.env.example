# Frontend: copy this file to artifacts/faraway/.env.local and supply your
# existing Supabase project's URL and publishable key locally.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Required when invoking Vite outside the managed Replit workflow.
PORT=5173
BASE_PATH=/

# Optional Express service; set PORT=5000 in its own terminal.
# LOG_LEVEL=info

# Optional workspace database library (not a replacement for Supabase):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Edge Function secrets are configured in Supabase, not in frontend files.
# Never put service-role, Gemini, or RunPod keys in VITE_* variables.
# See README.md for the server-side configuration names.
